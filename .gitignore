# Artefatos de deploy: são regenerados por deploy/empacotar.sh antes de cada build.
# O dist.tar.gz sozinho tem ~7 MB — não versione.
deploy/pacotes/

# Dependências instaladas localmente.
session/node_modules/

# O fork do Chili3D é um repositório git próprio (532 MB com o histórico).
# Ele fica fora deste versionamento: use um submódulo ou clone separado, e
# compile o dist/ quando precisar reconstruir a imagem web.
chili3d-upstream/

# Estado de runtime da máquina de desenvolvimento (não do container).
*.log
.env
.DS_Store
